APP_ENV=development
PAYMENT_PROVIDER=mock
DATABASE_PATH=./data/zal.db
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=
PLATEGA_API_KEY=
PLATEGA_FALLBACK_CALLBACK_URL=
ORDER_TOKEN_SECRET=
PAYMENT_RECONCILE_SECONDS=15
# Optional Russian catalog & reviews enrichment (works keyless via IMDb + Letterboxd + Wikipedia RU + Archive.org by default):
# For production use PAYMENT_PROVIDER=platega and a public HTTPS URL.
# Never use VITE_ prefixes for server secrets.

# 0 = catalog price; 100 = one-ruble hackathon checkout before provider fee.
DEMO_CHECKOUT_MINOR=0
